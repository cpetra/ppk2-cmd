# Nordic PPK2 Configuration
# Set the direct serial port to skip auto-discovery / probing on every run:
PPK2_PORT=/dev/ttyACM0

# Default voltage in millivolts (800 to 5000 mV)
PPK2_VOLTAGE=5000

# Default sampling duration in seconds
PPK2_DURATION=10.0

# Default mode: source (power DUT internally) or ampere (measure external supply)
PPK2_MODE=source
